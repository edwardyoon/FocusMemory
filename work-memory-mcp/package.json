{
  "name": "@focusmemory/work-memory-mcp",
  "version": "0.1.0",
  "description": "MCP server for FocusMemory — work history, decisions (Qdrant), docs/plans text search (Meilisearch), and code graph",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "create-collections": "node createCollection.js",
    "auto-ingest": "node autoIngest.js",
    "auto-ingest:force": "node autoIngest.js --force",
    "build-graph": "node buildGraph.js",
    "index-chunks": "node semantic_codesearch/indexCodeChunks.js",
    "index-chunks:force": "node semantic_codesearch/indexCodeChunks.js --force",
    "search": "node testSearch.js"
  },
  "keywords": [
    "mcp",
    "qdrant",
    "memory",
    "rag",
    "code-graph"
  ],
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@hono/node-server": "^2.1.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@qdrant/js-client-rest": "^1.18.0",
    "dotenv": "^17.4.2",
    "hono": "^4.13.0",
    "meilisearch": "^0.60.0",
    "mysql2": "^3.23.2",
    "node-fetch": "^3.3.2",
    "tree-sitter": "^0.25.1",
    "tree-sitter-javascript": "^0.25.0",
    "zod": "^4.4.3"
  }
}
