<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.focusmemory.autoingest</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/node</string>
        <string>/opt/homebrew/var/www/FocusMemory/work-memory-mcp/autoIngest.js</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/opt/homebrew/var/www/FocusMemory/work-memory-mcp</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <!-- Run every 30 minutes -->
    <key>StartInterval</key>
    <integer>60</integer>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/opt/homebrew/var/www/FocusMemory/work-memory-mcp/logs/autoingest.out.log</string>

    <key>StandardErrorPath</key>
    <string>/opt/homebrew/var/www/FocusMemory/work-memory-mcp/logs/autoingest.err.log</string>
</dict>
</plist>
