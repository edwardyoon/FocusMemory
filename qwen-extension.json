{
  "name": "focus-memory",
  "displayName": "FocusMemory MCP + Auto-recall",
  "description": "Qdrant-based work memory, project facts graph search and automatic context recall for qwen-code",
  "version": "1.0.0",

  "mcpServers": {
    "focus-memory": {
      "command": "node",
      "args": [
        "${extensionPath}${/}index.js"
      ],
      "cwd": "${extensionPath}",
      "env": {
        "QDRANT_URL": "http://localhost:6333",
        "BGE_URL": "http://localhost:8080/v1/embeddings",
        "SUMMARY_LLM_URL": "http://localhost:8081/v1/completions",
        "HTTP_PORT": "3900",
        "MEILI_HOST": "http://localhost:7700",
        "MEILI_INDEX": "docs_plans",
        "MEILI_MASTER_KEY": "${MEILI_MASTER_KEY}",
        "CONTEXT_API_TOKEN": "focus-memory-local",
        "FOCUS_LOG_FILE": "/tmp/focus-memory.log"
      }
    }
  },

  "hooks": {
    "UserPromptSubmit": [
      {
        "description": "FocusMemory auto context search — retrieves related work history and decisions from Qdrant on every prompt submission",
        "hooks": [
          {
            "type": "http",
            "url": "http://localhost:3900/v1/context/search",
            "timeout": 8,
            "headers": {
              "Authorization": "Bearer focus-memory-local",
              "Content-Type": "application/json",
              "X-Source": "hook"
            }
          }
        ]
      },
      {
        "description": "Hard Gate — reset memoryCalled flag at start of each new turn so grep_search/glob is blocked until search_memory runs first",
        "hooks": [
          {
            "type": "command",
            "command": "node ${extensionPath}${/}hooks${/}reset-memory-flag.js",
            "name": "reset-memory-flag",
            "timeout": 3000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^mcp__focus-memory__search_memory$",
        "hooks": [
          {
            "type": "command",
            "command": "node ${extensionPath}${/}hooks${/}log-tool-call.js",
            "name": "log-search-memory",
            "timeout": 5000
          }
        ]
      },
      {
        "matcher": "^mcp__focus-memory__remember_decision$",
        "hooks": [
          {
            "type": "command",
            "command": "node ${extensionPath}${/}hooks${/}log-tool-call.js",
            "name": "log-remember-decision",
            "timeout": 5000
          }
        ]
      },
      {
        "matcher": "^(edit|write_file)$",
        "hooks": [
          {
            "type": "command",
            "command": "node ${extensionPath}${/}hooks${/}log-tool-call.js",
            "name": "log-code-change",
            "timeout": 5000
          }
        ]
      },
      {
        "matcher": "^(grep_search|glob)$",
        "hooks": [
          {
            "type": "command",
            "command": "node ${extensionPath}${/}hooks${/}check-memory-first.js",
            "name": "check-memory-first",
            "timeout": 5000
          }
        ]
      }
    ],
    "Stop": [
      {
        "description": "Hard Gate (write-back) — detect completion signal and ask user to record decision via remember_decision",
        "hooks": [
          {
            "type": "command",
            "command": "node ${extensionPath}${/}hooks${/}check-writeback.js",
            "name": "check-writeback",
            "timeout": 8000
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "description": "Cleanup — remove this session's per-session state files and sweep stale files (7 days) left by sessions that ended without a SessionEnd event",
        "hooks": [
          {
            "type": "command",
            "command": "node ${extensionPath}${/}hooks${/}cleanup-session.js",
            "name": "cleanup-session",
            "timeout": 5000
          }
        ]
      }
    ]
  }
}
