# FocusMemory MCP Server Configuration

# Qdrant vector database (required)
QDRANT_URL=http://127.0.0.1:6333

# BGE-M3 embedding server (required for search and ingest)
BGE_URL=http://127.0.0.1:8080/v1/embeddings

# ── MCP server defaults (index.js) — this file is the sole config source
# (dotenv override:true: values here win over process env / settings.json) ──
# HTTP API port for the auto-recall hook (default 3900)
HTTP_PORT=3900
# Bearer token for the /v1/* HTTP API (default focus-memory-local)
CONTEXT_API_TOKEN=focus-memory-local
# Log file for the MCP server process (default: stdout only)
FOCUS_LOG_FILE=/tmp/focus-memory.log

# Summary lightweight LLM for prune & summarize (optional, graceful fallback if unavailable)
# chat-completions contract — the server must separate thinking into reasoning_content
SUMMARY_LLM_URL=http://127.0.0.1:8081/v1/chat/completions
SUMMARY_LLM_MODEL=gemma-4

# Main LLM for task registration (taskReceiver.cjs) formatting (completions API)
MAIN_LLM=http://127.0.0.1:8080/v1/completions
MAIN_LLM_MODEL=qwen27b

# ── SKILL.state (PreCompact / SessionStart hooks) ──────────────────────────
# Structured execution state (Σ) across context compaction.
# on  -> a detached PreCompact worker extracts a state patch from the
#        transcript tail (via MAIN_LLM above, falling back to SUMMARY_LLM)
#        into ~/.qwen/tmp/focus-memory/state/<sid>.json + a work_memory
#        state_checkpoint; SessionStart(compact) re-injects Σ afterwards.
# off -> hooks no-op immediately; auto-recall + Hard Gate stay untouched.
# dotenv override:true -> values in this file win over process env
# (shell exports or ~/.qwen/settings.json "env" are overridden by this file).
FOCUSMEMORY_SKILLSTATE=off
# Optional: transcript window for extraction in rendered chars (default 30000, min 2000)
# FOCUSMEMORY_SKILLSTATE_MAX_CHARS=30000

# Document language for generated todos (taskReceiver.cjs). Default EN.
# KR -> todos items/headers written in Korean; EN -> English.
DOCS_LANGUAGE=EN

# SearXNG instance for web search (required for search_web tool)
SEARXNG_URL=http://127.0.0.1:18080

# Project directories for doc/plan/todo indexing
DOCS_DIR={your_workspace}/docs
PLANS_DIR={your_workspace}/plans
TODOS_DIR={your_workspace}/todos

# Meilisearch full-text search (required for docs_plans and code_structure indexes)
MEILI_HOST=http://127.0.0.1:7700
MEILI_INDEX=docs_plans
MEILI_MASTER_KEY=your_master_key_here

# ── Post-run verification (todoRunner.js) ──────────────────────────────────
# Shell script run ONCE at the very end of a fully completed TODO run
# (all items marked [x] and qwen exited 0) — never per item. If the script
# exits non-zero, one qwen fix round is delegated, then the script is
# re-run as the independent arbiter. Unset or empty = feature disabled.
# Path: absolute, or relative to the workspace root (parent of todos/).
#POSTRUN_TEST_SCRIPT=scripts/nightly_test.sh

# ── todoRunner.js daily backlog run time ───────────────────────────────────
# 24h "HH:MM" (local time). Unset or invalid values fall back to 06:00.
# Apply changes with: pm2 restart todo-runner
TODO_RUN_TIME=02:00
